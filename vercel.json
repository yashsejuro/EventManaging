{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "clubevents/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles_build"
      }
    }
  ],
  "routes": [
    {
      "src": "/favicon.ico",
      "dest": "/static/images/favicon.svg",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/media/posters/demo/(.*)",
      "dest": "/static/posters/demo/$1",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "clubevents/wsgi.py"
    }
  ]
}
