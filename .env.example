# Copy this file to .env for local overrides. Never commit real secrets.

# Security & Core
SECRET_KEY=replace-with-a-long-random-50-plus-char-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://eventmanaging-blue.vercel.app
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Neon PostgreSQL (optional locally; defaults to SQLite when omitted)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Cloudinary Media Storage (optional locally; defaults to local media/ when omitted)
# Either provide CLOUDINARY_URL or the three individual keys below.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Transactional Email SMTP (Brevo / Resend / Gmail SMTP; defaults to console when EMAIL_HOST is blank)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=ClubEvents <noreply@yourdomain.com>
